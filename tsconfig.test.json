{
  // Type-checks the tests and Playwright config (no output; tests run through tsx / Playwright)
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "rootDir": ".", "module": "Preserve", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"] },
  "include": ["src/**/*.ts", "test/**/*.ts", "playwright.config.ts"],
  "exclude": ["src/client"]
}
