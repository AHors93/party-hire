# Copy to .env for local use. On Replit, add these under "Secrets" instead.

# --- Required ---
ADMIN_PASSWORD=change-me-to-something-long
HOME_POSTCODE=M1 1AE            # where you drive from (never shown to customers)

# --- Your business ---
BUSINESS_NAME=Party Table & Chair Hire
CONTACT_PHONE=07123 456789      # shown in the footer
PUBLIC_URL=                     # e.g. https://party-hire.yourname.repl.co (for links in messages)

# --- Prices & stock ---
TABLE_PRICE=7.50
CHAIR_PRICE=1.50
TOTAL_TABLES=10
TOTAL_CHAIRS=60
MAX_HIRE_DAYS=14
BOOKING_FEE=1.50               # flat fee per booking, covers running costs. 0 = none
DEPOSIT_PERCENT=10              # refundable, % of the hire cost. 0 = no deposit

# --- Delivery estimate ---
MPG=40
FUEL_PRICE_PER_LITRE=1.40
DELIVERY_TRIPS=2                # drop-off + collection = 2 return trips
DELIVERY_BASE_FEE=0             # extra on top of fuel, e.g. 5 for your time
MIN_DELIVERY_FEE=0
FREE_DELIVERY_MILES=0           # e.g. 3 = free delivery within 3 miles
MAX_DELIVERY_MILES=30           # beyond this the customer is told it's outside your area

# --- Payment (only used in the confirmation message you send) ---
BANK_DETAILS="Name: A Smith | Sort code: 00-00-00 | Account: 12345678"

# --- Phone notifications (optional, free): install the ntfy app and subscribe to this topic ---
NTFY_TOPIC=                     # pick something unguessable, e.g. adam-party-hire-8f3k2
